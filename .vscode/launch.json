{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define-from-file=env/.env.dev"
      ]
      
    },
    {
      "name": "Training Academy Dev",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define-from-file=env/.env.dev"
      ]
    },
    {
      "name": "Training Academy Dev (Profile)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "cwd": "${workspaceFolder}",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define-from-file=env/.env.dev"
      ]
    },
    {
      "name": "Training Academy Dev (Release)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "cwd": "${workspaceFolder}",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define-from-file=env/.env.dev"
      ]
    }
  ]
}
